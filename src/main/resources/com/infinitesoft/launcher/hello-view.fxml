<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="680.0" prefWidth="920.0" xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.infinitesoft.launcher.HelloController">
    <children>
        <HBox alignment="CENTER_LEFT" prefHeight="72.0" prefWidth="200.0" spacing="12.0" style="-fx-background-color: #f0f0f0;">
            <children>
                <Label text="Estado General:">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
                <Label fx:id="labelGeneralStatus" text="Iniciando">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
                <Button fx:id="launchAppButton" mnemonicParsing="false" onAction="#onLaunchApp" text="Ejecutar aplicacion" />
                <Button mnemonicParsing="false" onAction="#onOpenBrowser" text="Abrir en navegador" />
                <Button mnemonicParsing="false" onAction="#onOpenMicotizacionTunnel" text="Cotización (túnel)" />
                <Button mnemonicParsing="false" onAction="#onConfigureLanHost" text="Configurar IP" style="-fx-font-size: 11px;" />
            </children>
            <padding>
                <Insets left="20.0" />
            </padding>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #fafafa;">
            <children>
                <Label text="Ambiente:" style="-fx-font-size: 12px;" />
                <ComboBox fx:id="comboEnvironment" prefWidth="200" onAction="#onEnvironmentChanged" />
                <Button mnemonicParsing="false" onAction="#onPrepareHost" text="Preparar esta máquina" />
                <Label fx:id="labelLanHost" text="IP LAN: 192.168.1.6" style="-fx-font-size: 11px; -fx-text-fill: #555;" />
                <Label fx:id="labelTunnelUrl" text="Público: túnel pendiente…" style="-fx-font-size: 11px; -fx-text-fill: #555;" wrapText="true" maxWidth="280" />
            </children>
            <padding>
                <Insets bottom="8.0" left="20.0" right="20.0" top="8.0" />
            </padding>
        </HBox>
        <ScrollPane fitToWidth="true" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="servicesContainer" spacing="10.0">
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label text="Base de Datos (DB)" prefWidth="220"/>
                                <Label fx:id="statusDb" text="Detenido" prefWidth="110"/>
                                <Button onAction="#onStartDb" text="Iniciar"/>
                                <Button onAction="#onStopDb" text="Detener"/>
                                <Button onAction="#onRestartDb" text="Reiniciar"/>
                                <Button onAction="#onOpenDbManager" text="Abrir gestor DB"/>
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label text="Seguridad" prefWidth="220"/>
                                <Label fx:id="statusSecurity" text="Detenido" prefWidth="110"/>
                                <Button onAction="#onStartSecurity" text="Iniciar"/>
                                <Button onAction="#onStopSecurity" text="Detener"/>
                                <Button onAction="#onRestartSecurity" text="Reiniciar"/>
                                <Button onAction="#onUpdateSecurity" text="Actualizar"/>
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label text="Correos (SMTP)" prefWidth="220"/>
                                <Label fx:id="statusSmtp" text="Detenido" prefWidth="110"/>
                                <Button onAction="#onStartSmtp" text="Iniciar"/>
                                <Button onAction="#onStopSmtp" text="Detener"/>
                                <Button onAction="#onRestartSmtp" text="Reiniciar"/>
                                <Button onAction="#onUpdateSmtp" text="Actualizar"/>
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label text="Lógica Tienda" prefWidth="220"/>
                                <Label fx:id="statusStore" text="Detenido" prefWidth="110"/>
                                <Button onAction="#onStartStore" text="Iniciar"/>
                                <Button onAction="#onStopStore" text="Detener"/>
                                <Button onAction="#onRestartStore" text="Reiniciar"/>
                                <Button onAction="#onUpdateStore" text="Actualizar"/>
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label text="Puente (correo banco)" prefWidth="220"/>
                                <Label fx:id="statusPuente" text="Detenido" prefWidth="110"/>
                                <Button onAction="#onStartPuente" text="Iniciar"/>
                                <Button onAction="#onStopPuente" text="Detener"/>
                                <Button onAction="#onRestartPuente" text="Reiniciar"/>
                                <Button onAction="#onUpdatePuente" text="Actualizar"/>
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label text="Frontend" prefWidth="220"/>
                                <Label fx:id="statusFront" text="Detenido" prefWidth="110"/>
                                <Button onAction="#onStartFront" text="Iniciar"/>
                                <Button onAction="#onStopFront" text="Detener"/>
                                <Button onAction="#onRestartFront" text="Reiniciar"/>
                                <Button onAction="#onUpdateFront" text="Actualizar"/>
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label text="Caddy (portero del túnel)" prefWidth="220"/>
                                <Label fx:id="statusCaddy" text="Detenido" prefWidth="110"/>
                                <Button onAction="#onStartCaddy" text="Iniciar"/>
                                <Button onAction="#onStopCaddy" text="Detener"/>
                                <Button onAction="#onRestartCaddy" text="Reiniciar"/>
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label text="Túnel Cloudflare" prefWidth="220"/>
                                <Label fx:id="statusTunnel" text="Detenido" prefWidth="110"/>
                                <Button onAction="#onStartTunnel" text="Iniciar"/>
                                <Button onAction="#onRestartTunnel" text="Reiniciar"/>
                                <Label text="Arranca al iniciar sesión (sobrevive el reinicio del PC)" style="-fx-font-size: 11px; -fx-text-fill: #666;" wrapText="true" maxWidth="280"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
        <HBox alignment="CENTER_LEFT" prefHeight="40.0" prefWidth="200.0" spacing="8.0" style="-fx-background-color: #e8e8e8;">
            <children>
                <Label text="Ruta proyectos:" style="-fx-font-size: 11px;" />
                <Label fx:id="labelBasePath" text="" style="-fx-font-size: 11px; -fx-text-fill: #555;" />
                <Button mnemonicParsing="false" onAction="#onSelectProjectsFolder" text="Cambiar Ruta" style="-fx-font-size: 11px;" />
            </children>
            <padding>
                <Insets left="10.0" right="10.0" />
            </padding>
        </HBox>
        <HBox alignment="CENTER_RIGHT" prefHeight="50.0" prefWidth="200.0" spacing="10.0" style="-fx-background-color: #f0f0f0;">
            <children>
                <Button mnemonicParsing="false" onAction="#onOpenLogs" text="Ver Logs" />
                <Button mnemonicParsing="false" onAction="#onStartAll" text="Iniciar Todo" />
                <Button mnemonicParsing="false" onAction="#onStopAll" text="Detener Todo" />
                <Button mnemonicParsing="false" onAction="#onRestartAll" text="Reiniciar Todo" />
            </children>
            <padding>
                <Insets right="10.0" />
            </padding>
        </HBox>
    </children>
</VBox>
